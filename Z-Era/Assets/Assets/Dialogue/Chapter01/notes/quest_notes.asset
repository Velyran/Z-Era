  - nodeId: note_04
    speakerName: "\u54C8\u73C0\u4E2D\u58EB"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u6B64\u6B21\u4EFB\u52A1\u635F\u5931\u60E8\u91CD\uFF0C\u5C24\u5176\u662F\u4EBA\u5458\u4E0A\u7684\u635F\u5931\uFF0C\u884C\u8FDB\u81F3\u7070\u6E2F\u4E34\u65F6\u8425\u5730\u65F6\uFF0C\u5DF2\u67097\u4EBA\u9635\u4EA1\uFF0C5\u4EBA\u5931\u8E2A\u3002"

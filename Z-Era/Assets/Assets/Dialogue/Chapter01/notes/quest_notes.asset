    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u4E0A\u7EA7\u5411\u6211\u4EEC\u9690\u7792\u4E86\u6B64\u6B21\u884C\u52A8\u7684\u7EC6\u8282\uFF0C\u5C24\u5176\u662F\u9690\u7792\u4E86\u6B64\u6B21\u884C\u52A8\u7684\u5371\u9669\u7A0B\u5EA6\uFF01\u8FD9\u4E9B\u53EF\u662F\u6267\u884C\u884C\u52A8\u7684\u6700\u57FA\u7840\u7684\u4FE1\u606F\uFF0C\u5230\u5E95\u662F\u4E0A\u7EA7\u4FE1\u606F\u4F20\u9012\u7684\u5931\u8BEF\uFF0C\u8FD8\u662F\u4ED6\u4EEC\u6545\u610F\u4E3A\u4E4B......"
    endsDialogue: 0
    choices:
    - buttonText: "\u4E0B\u4E00\u6761\u8BB0\u5F55\u3002"

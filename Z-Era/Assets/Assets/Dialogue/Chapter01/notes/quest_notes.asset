    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u770B\u8D77\u6765\u8FD9\u662F\u54C8\u73C0\u4E2D\u58EB\u7684\u4EFB\u52A1\u7B14\u8BB0\uFF0C\u6B63\u5E38\u6765\u8BF4\u4ED6\u5E94\u8BE5\u968F\u8EAB\u5E26\u7740\uFF0C\u4F46\u88AB\u4ED6\u7559\u5728\u4E86\u8FD9\u91CC\u3002"

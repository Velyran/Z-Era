    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u9635\u4EA1\u548C\u5931\u8E2A\u7684\u53EF\u662F\u6211\u7684\u6218\u53CB\uFF0C\u906D\u53D7\u82E6\u96BE\u7684\u662F\u7070\u6E2F\u7684\u5E02\u6C11\uFF0C\u4ED6\u4EEC\u600E\u4E48\u80FD\u591F......\u53EF\u662F\u519B\u4EE4\u5982\u5C71\uFF0C\u6211\u5FC5\u987B\u5E26\u7740\u5269\u4E0B\u7684\u961F\u4F0D\u524D\u5F80\u4E0B\u4E00\u4E2A\u4EFB\u52A1\u5730\u70B9\u3002"

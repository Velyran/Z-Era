    portrait: {fileID: 0}
    text: "\u6211\u5411\u4E0A\u7EA7\u6C47\u62A5\u4E86\u4EBA\u5458\u60C5\u51B5\uFF0C\u5E76\u8BF7\u6C42\u6211\u4EEC\u5269\u4F59\u4EBA\u5458\u5148\u5728\u7070\u6E2F\u5BFB\u627E\u5931\u8E2A\u4EBA\u5458\uFF0C\u540C\u65F6\u641C\u6551\u7070\u6E2F\u5E78\u5B58\u7684\u5E02\u6C11\uFF0C\u4F46\u662F\u4ED6\u4EEC\u4E0D\u5141\u8BB8\uFF0C\u8BA9\u6211\u4EEC\u524D\u5F80\u4E0B\u4E00\u4E2A\u4EFB\u52A1\u5730\u70B9\u3002"
    endsDialogue: 0

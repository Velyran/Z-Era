  - nodeId: daniel_04
    speakerName: 
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u4E39\u5C3C\u5C14\u6C89\u9ED8\u4E86\u4E00\u4F1A\uFF0C\u4F60\u9690\u7EA6\u542C\u5230\u4ED6\u5728\u8F7B\u8F7B\u62BD\u564E\u3002"
    endsDialogue: 0

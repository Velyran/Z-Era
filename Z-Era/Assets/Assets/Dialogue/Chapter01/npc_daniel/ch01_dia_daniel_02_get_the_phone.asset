  - nodeId: daniel_16
    speakerName: "\u4E39\u5C3C\u5C14"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u522B\u5BA2\u6C14\uFF0C\u6211\u6162\u6162\u5F00\u59CB\u540C\u610F\u5A01\u5EC9\u7684\u8BF4\u6CD5\uFF0C\u4E92\u76F8\u5E2E\u52A9\u603B\u6BD4\u72EC\u81EA\u4E00\u4EBA\u66F4\u6709\u5E0C\u671B\u3002"

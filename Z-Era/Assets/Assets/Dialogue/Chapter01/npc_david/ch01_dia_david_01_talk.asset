  - nodeId: david_03
    speakerName: "\uFF1F\uFF1F\uFF1F"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u8FD8\u771F\u662F\u4E2A\u5927\u6D3B\u4EBA\uFF0C\u6211\u5DF2\u7ECF\u597D\u51E0\u5929\u6CA1\u89C1\u5230\u6D3B\u4EBA\u4E86\uFF0C\u4F60\u8981\u4E0D\u8981\u6765\u8DDF\u6211\u804A\u804A\u5929\u3002"
    endsDialogue: 0
    choices:
    - buttonText: "\u4F60\u5728\u54EA\uFF1F"

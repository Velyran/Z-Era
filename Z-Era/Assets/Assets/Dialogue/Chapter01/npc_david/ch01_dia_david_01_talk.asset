  - nodeId: david_02
    speakerName: "\uFF1F\uFF1F\uFF1F"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u5582\uFF0C\u4F60\u8981\u662F\u542C\u5F97\u61C2\uFF0C\u5C31\u56DE\u5E94\u6211\uFF0C\u4E0D\u7136\u6211\u5C31\u628A\u4F60\u5F53\u6210\u90A3\u4E9B\u602A\u7269\u5C04\u6740\u4E86\u3002"

        m_PersistentCalls:
          m_Calls: []
  - nodeId: david_04
    speakerName: "\uFF1F\uFF1F\uFF1F"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u5728\u4F60\u5BF9\u9762\u7684\u9910\u9986\uFF0C\u8FDB\u6765\u5427\uFF0C\u4E00\u76F4\u7528\u5927\u55D3\u95E8\u8DDF\u4F60\u8BF4\u8BDD\uFF0C\u4E5F\u5BB9\u6613\u628A\u90A3\u4E9B\u602A\u7269\u62DB\u6765\u3002"

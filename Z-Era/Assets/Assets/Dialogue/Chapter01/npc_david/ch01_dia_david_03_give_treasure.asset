  - nodeId: david_02
    speakerName: "\u5927\u536B"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u54CE\u5440\u5440\uFF0C\u4F60\u8FD9\u662F\u628A\u4ED6\u4EEC\u7684\u5BB6\u5E95\u90FD\u638F\u5B8C\u4E86\u5417\uFF0C\u8FD9\u4FE9\u90FD\u53EF\u503C\u94B1\u4E86\uFF01"
    endsDialogue: 0
    choices: []
  - nodeId: david_03
    speakerName: "\u5927\u536B"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u4E00\u6761\u5B9D\u77F3\u9879\u94FE\uFF0C\u4E00\u4E2A\u9AD8\u7EAF\u5EA6\u91D1\u5956\u724C\uFF0C\u6211\u7684\u5929\u554A\u58EB\u5175\u5927\u4EBA\uFF0C\u4F60\u7684\u6536\u83B7\u8D85\u51FA\u4E86\u6211\u7684\u9884\u671F\uFF0C\u6211\u4EE5\u4E3A\u90A3\u5E2E\u75AF\u5B50\u65E9\u5C31\u5E26\u7740\u5B9D\u8D1D\u8DD1\u8DEF\u4E86\uFF0C\u7ED3\u679C\u88AB\u4F60\u627E\u6765\u8FD9\u4FE9\u7956\u5B97\u3002\u6211\u8BE5\u600E\u4E48\u62A5\u7B54\u4F60\u58EB\u5175\u5927\u4EBA\u3002"
    endsDialogue: 0
    choices:
    - buttonText: "\u544A\u8BC9\u6211\u600E\u4E48\u524D\u5F80\u96F6\u53F7\u96A7\u9053\u5C31\u884C\u3002"
      requiredFlags: []
      forbiddenFlags: []
      nextNodeId: 
      onSelected:
        m_PersistentCalls:
          m_Calls: []
  - nodeId: david_04
    speakerName: "\u5927\u536B"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u8FD9\u6CA1\u95EE\u9898\uFF0C\u6211\u7684\u9910\u9986\u540E\u95E8\u5C31\u76F4\u63A5\u901A\u5F80\u96F6\u53F7\u96A7\u9053\uFF0C\u53EA\u4E0D\u8FC7......\u4E00\u8DEF\u4E0A\u6709\u5F88\u591A\u611F\u67D3\u8005\u3002"
    endsDialogue: 0
    choices: []
  - nodeId: david_05
    speakerName: "\u5927\u536B"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u867D\u7136\u6211\u5E73\u65F6\u5927\u5927\u54A7\u54A7\u7684\uFF0C\u4F46\u8FD8\u662F\u77E5\u9053\u611F\u67D3\u8005\u6709\u591A\u5371\u9669\uFF0C\u5982\u679C\u4F60\u4E00\u5B9A\u8981\u524D\u5F80\u96F6\u53F7\u96A7\u9053\uFF0C\u6211\u7ED9\u4F60\u4E00\u4E9B\u8BDA\u5FC3\u7684\u5EFA\u8BAE\u3002"
    endsDialogue: 0
    choices: []
  - nodeId: david_06
    speakerName: "\u5927\u536B"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u9910\u9986\u540E\u95E8\u8FC7\u53BB\u6709\u4E00\u7247\u5C45\u4F4F\u533A\uFF0C\u90A3\u91CC\u9762\u5927\u6982\u7387\u6709\u5F39\u836F\u8865\u7ED9\uFF0C\u5982\u679C\u4F60\u7684\u5F39\u836F\u5145\u8DB3\uFF0C\u90A3\u4E00\u8DEF\u4E0A\u7684\u611F\u67D3\u8005\u5BF9\u4F60\u5C31\u4E0D\u4F1A\u9020\u6210\u592A\u5927\u7684\u5A01\u80C1\u3002"
    endsDialogue: 0
    choices:
    - buttonText: "\u611F\u8C22\u4F60\u7684\u5EFA\u8BAE\uFF0C\u6211\u4F1A\u53BB\u770B\u770B\u7684\u3002"
      requiredFlags: []
      forbiddenFlags: []
      nextNodeId: 
      onSelected:
        m_PersistentCalls:
          m_Calls: []
  - nodeId: david_07
    speakerName: "\u5927\u536B"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u4F60\u662F\u5A01\u5EC9\u7684\u670B\u53CB\uFF0C\u8FD8\u5E2E\u6211\u627E\u5230\u4E86\u8FD9\u4E48\u597D\u7684\u5B9D\u8D1D\uFF0C\u81EA\u7136\u4E5F\u662F\u6211\u7684\u670B\u53CB\u3002\u5982\u679C\u4F60\u53CD\u6094\u4E86\uFF0C\u6B22\u8FCE\u968F\u65F6\u56DE\u6765\uFF0C\u867D\u7136\u770B\u4F60\u7684\u6837\u5B50\u5341\u5206\u51B3\u7EDD\u3002"
    endsDialogue: 0
    choices: []
  - nodeId: david_08
    speakerName: "\u5927\u536B"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u603B\u4E4B\uFF0C\u51FA\u4E86\u9910\u9986\u540E\u95E8\uFF0C\u4F60\u5148\u4E0A\u5230\u6C7D\u8F66\u65C5\u9986\u4E8C\u697C\uFF0C\u518D\u4ECE\u53E6\u4E00\u8FB9\u7684\u697C\u68AF\u4E0B\u53BB\uFF0C\u4E4B\u540E\u53EA\u8981\u6709\u901A\u8DEF\uFF0C\u4F60\u5C31\u4E00\u76F4\u5F80\u524D\u5C31\u884C\u4E86\uFF0C\u8FC7\u51E0\u4E2A\u8857\u9053\u4F60\u5C31\u80FD\u770B\u5230\u96F6\u53F7\u96A7\u9053\u7684\u5165\u53E3\u4E86\u3002"
    endsDialogue: 0

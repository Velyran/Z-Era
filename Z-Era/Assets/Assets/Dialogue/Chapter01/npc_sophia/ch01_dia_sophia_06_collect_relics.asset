          m_Calls: []
  - nodeId: sophia_02
    speakerName: "\u7D22\u83F2\u4E9A"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u8C22\u8C22\uFF0C\u8FD9\u4E9B\u7269\u8D44\u8DB3\u591F\u6211\u4EEC\u518D\u652F\u6491\u4E00\u6BB5\u65F6\u95F4\u4E86\u3002\u81EA\u4ECE\u707E\u96BE\u53D1\u751F\u4E4B\u540E\uFF0C\u7269\u8D44\u53D8\u5F97\u7D27\u7F3A\uFF0C\u4E5F\u4E0D\u77E5\u9053\u8054\u90A6\u8FD8\u4F1A\u4E0D\u4F1A\u5411\u7070\u6E2F\u63D0\u4F9B\u7269\u8D44\u652F\u63F4\u3002"
    endsDialogue: 0
    choices: []
  - nodeId: sophia_03
    speakerName: "\u7D22\u83F2\u4E9A"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u5728\u4F60\u53BB\u8D85\u5E02\u641C\u5BFB\u7269\u8D44\u671F\u95F4\uFF0C\u6211\u548C\u4E39\u5C3C\u5C14\u804A\u4E86\u4E00\u4E0B\uFF0C\u4ED6\u786E\u5B9E\u5341\u5206\u4EC7\u6068\u8054\u90A6\u548C\u8054\u90A6\u519B\u961F\uFF0C\u56E0\u4E3A\u4ED6\u7684\u5BB6\u4EBA\u5728\u8FD9\u573A\u707E\u96BE\u4E2D\u5931\u53BB\u4E86\u751F\u547D......"
    endsDialogue: 0
    choices: []
  - nodeId: sophia_04
    speakerName: "\u7D22\u83F2\u4E9A"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u8FD9\u4E5F\u662F\u4E3A\u4EC0\u4E48\u4ED6\u5BF9\u4F60\u6709\u8FD9\u4E48\u5927\u7684\u6076\u610F\u7684\u539F\u56E0\uFF0C\u707E\u96BE\u53D1\u751F\u540E\uFF0C\u8054\u90A6\u5E76\u672A\u53CA\u65F6\u652F\u63F4\uFF0C\u800C\u662F\u9009\u62E9\u4F7F\u7528\u6E29\u538B\u5F39\u6E05\u6D17\u8FD9\u4E00\u5207\uFF0C\u8FD9\u4E3E\u52A8\u4E5F\u8BA9\u7070\u6E2F\u5E02\u6C11\u5BF9\u8054\u90A6\u5931\u671B\u4E0E\u75DB\u6068\u3002"
    endsDialogue: 0
    choices: []
  - nodeId: sophia_05
    speakerName: "\u7D22\u83F2\u4E9A"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u4E39\u5C3C\u5C14\u524D\u5929\u66FE\u4E0E\u8054\u90A6\u519B\u961F\u6709\u8FC7\u4EA4\u96C6\uFF0C\u4F46\u5177\u4F53\u8C08\u4E86\u4E9B\u4EC0\u4E48\uFF0C\u4ED6\u4E0D\u613F\u610F\u8BF4\u3002"
    endsDialogue: 0
    choices: []
  - nodeId: sophia_07
    speakerName: "\u7D22\u83F2\u4E9A"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u4ED6\u5BB6\u4EBA\u7684\u9057\u7269\u6389\u843D\u5728\u533B\u96622\u53F7\u697C\u7684\u4E0A\u5C42\uFF0C\u636E\u8BF4\u662F\u4ED6\u5BB6\u4EBA\u7684\u624B\u673A\u3002\u5982\u679C\u80FD\u5E26\u56DE\u7ED9\u4ED6\uFF0C\u6216\u8BB8\u4ED6\u613F\u610F\u653E\u4E0B\u5BF9\u4F60\u7684\u6212\u5907\uFF0C\u66F4\u4F55\u51B5\u6211\u548C\u5A01\u5EC9\u76F8\u4FE1\u4F60\u662F\u4E2A\u597D\u4EBA\u3002"
    endsDialogue: 0
    choices:
    - buttonText: "\u65E2\u7136\u4ED6\u77E5\u9053\u519B\u961F\u7684\u4FE1\u606F\uFF0C\u6211\u4F1A\u5E2E\u52A9\u4ED6\u7684\u3002"
      requiredFlags: []
      forbiddenFlags: []
      nextNodeId: 
      onSelected:
        m_PersistentCalls:
          m_Calls: []
  - nodeId: sophia_08
    speakerName: "\u7D22\u83F2\u4E9A"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u6CE8\u610F\u5B89\u5168\uFF0C2\u53F7\u697C\u4E2D\u4E5F\u6709\u90A3\u4E9B\u602A\u7269\u3002"
    endsDialogue: 0
    choices: []
  - nodeId: sophia_09
    speakerName: "\u7D22\u83F2\u4E9A"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u5BF9\u4E86\uFF0C\u7279\u857E\u838E\u6709\u4E8B\u627E\u4F60\uFF0C\u6216\u8BB8\u51FA\u53D1\u5E2E\u4E39\u5C3C\u5C14\u5BFB\u627E\u5BB6\u4EBA\u9057\u7269\u524D\uFF0C\u4F60\u53EF\u4EE5\u8DDF\u5979\u804A\u4E00\u4E0B\u3002"
    endsDialogue: 0
    choices: []

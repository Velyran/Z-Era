  nodes:
  - nodeId: teresa_01
    speakerName: "\u7279\u857E\u838E"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u4F60\u597D\uFF0C\u58EB\u5175\u5148\u751F\u3002\u5F88\u62B1\u6B49\u6253\u6270\u4F60\uFF0C\u4F46\u6211\u6709\u4E00\u8981\u4E8B\u76F8\u6C42\u3002"
    endsDialogue: 0
    choices: []
  - nodeId: teresa_02
    speakerName: "\u7279\u857E\u838E"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u707E\u96BE\u521D\u671F\uFF0C\u6211\u6240\u5728\u7684\u6559\u5802\u4E2D\u5C31\u51FA\u73B0\u4E86\u90A3\u79CD\u55DC\u8840\u7684\u602A\u7269\uFF0C\u4F46\u5F53\u65F6\u6240\u6709\u4EBA\u90FD\u6CA1\u6709\u9632\u5907\uFF0C\u6B63\u5728\u7977\u544A\u7684\u4EBA\u4EEC\u4E71\u6210\u4E86\u4E00\u56E2\u3002"
    endsDialogue: 0
    choices: []
  - nodeId: teresa_03
    speakerName: "\u7279\u857E\u838E"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u795E\u7236\u5148\u751F\u5F88\u5FEB\u4ECE\u60CA\u5413\u4E2D\u51B7\u9759\u8FC7\u6765\uFF0C\u4ED6\u5B89\u629A\u4E86\u6211\u4EEC\uFF0C\u8BA9\u6211\u4EEC\u5148\u758F\u6563\u6C11\u4F17\uFF0C\u7136\u540E\u4ED6\u72EC\u81EA\u53BB\u5E94\u5BF9\uFF0C\u8FD8\u8BD5\u56FE\u548C\u90A3\u4E9B\u602A\u7269\u5BF9\u8BDD\u3002"
    endsDialogue: 0
    choices: []
  - nodeId: teresa_04
    speakerName: "\u7279\u857E\u838E"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u4F46\u4ED6\u5E76\u4E0D\u77E5\u9053\u90A3\u4E9B\u602A\u7269\u5DF2\u7ECF\u4E0D\u662F\u4EBA\u4E86\uFF0C\u602A\u7269\u54AC\u4E86\u4ED6\uFF0C\u6211\u89C1\u72B6\u9A6C\u4E0A\u53BB\u628A\u4ED6\u62C9\u5230\u6559\u5802\u91CC\u4E00\u4E2A\u9690\u853D\u7684\u5730\u65B9\u3002\u4ED6\u4F24\u5F97\u5F88\u91CD\uFF0C\u8840\u6D41\u4E0D\u6B62\uFF0C\u8C8C\u4F3C\u662F\u88AB\u54AC\u7A7F\u4E86\u52A8\u8109\u3002"
    endsDialogue: 0
    choices: []
  - nodeId: teresa_05
    speakerName: "\u7279\u857E\u838E"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u5F53\u65F6\u6211\u53EA\u597D\u5E26\u4ED6\u53BB\u533B\u9662\uFF0C\u533B\u9662\u91CC\u4E5F\u5F88\u591A\u88AB\u54AC\u4F24\u7684\u4EBA\uFF0C\u5C3D\u7BA1\u5F88\u5FD9\u5F88\u6324\uFF0C\u4F46\u62A4\u58EB\u8FD8\u662F\u628A\u4ED6\u5B89\u6392\u5230\u4E86\u533B\u96621\u53F7\u697C\u4E2D\u7B49\u5F85\u6CBB\u7597\u3002"
    endsDialogue: 0
    choices: []
  - nodeId: teresa_06
    speakerName: "\u7279\u857E\u838E"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u4E0D\u7BA1\u662F\u52A8\u8109\u7834\u88C2\u5374\u6CA1\u6709\u8DB3\u591F\u7684\u533B\u751F\u5E2E\u4ED6\u6CBB\u7597\uFF0C\u8FD8\u662F\u88AB\u90A3\u4E9B\u602A\u7269\u54AC\u4F24\uFF0C\u795E\u7236\u5148\u751F\u90FD\u662F\u6D3B\u4E0D\u4E0B\u53BB\u7684\u3002"
    endsDialogue: 0
    choices: []
  - nodeId: teresa_07
    speakerName: "\u7279\u857E\u838E"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u6700\u7EC8\u4ED6\u57281\u53F7\u697C\u8FC7\u4E16\u4E86\uFF0C\u4ED6\u7684\u5341\u5B57\u67B6\u843D\u5728\u4E86\u90A3\u91CC\uFF0C\u4E3A\u4E86\u9003\u547D\uFF0C\u6211\u5E76\u6CA1\u6709\u5E26\u8D70\u8C61\u5F81\u4ED6\u4FE1\u4EF0\u7684\u5341\u5B57\u67B6\u3002"
    endsDialogue: 0
    choices: []
  - nodeId: teresa_09
    speakerName: "\u7279\u857E\u838E"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u5982\u679C\u58EB\u5175\u5148\u751F\u80FD\u5E2E\u6211\u53D6\u56DE\u795E\u7236\u7684\u5341\u5B57\u67B6\uFF0C\u6211\u4F1A\u5411\u4F60\u652F\u4ED8\u62A5\u916C\u3002"
    endsDialogue: 0
    choices:
    - buttonText: "\u6211\u7B54\u5E94\u5E2E\u4F60\u53BB\u627E\u3002"

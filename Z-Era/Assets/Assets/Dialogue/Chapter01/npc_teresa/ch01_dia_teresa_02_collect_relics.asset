    text: "\u611F\u8C22\u4F60\u5148\u751F\uFF0C\u533B\u96621\u53F7\u697C\u5728\u6025\u8BCA\u5927\u697C\u7684\u5DE6\u4FA7\uFF0C\u5341\u5B57\u67B6\u4E0D\u786E\u5B9A\u9057\u5931\u5728\u90A3\u4E00\u5C42\u697C\uFF0C\u8FD8\u9700\u8981\u4F60\u5E2E\u5FD9\u5BFB\u627E\u3002"
    endsDialogue: 0

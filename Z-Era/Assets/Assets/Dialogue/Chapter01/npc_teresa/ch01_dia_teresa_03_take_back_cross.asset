    speakerName: "\u7279\u857E\u838E"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u6211\u66FE\u8FD4\u56DE\u8FC7\u6559\u5802\uFF0C\u90A3\u91CC\u88AB\u66B4\u5F92\u7834\u574F\u4E86\uFF0C\u8054\u90A6\u519B\u961F\u628A\u90A3\u4E9B\u66B4\u5F92\u8D76\u8D70\u540E\uFF0C\u5728\u90A3\u91CC\u7559\u4E0B\u4E86\u51E0\u4E2A\u88C5\u5907\u7BB1\uFF0C\u5E76\u4E14\u628A\u88C5\u5907\u7BB1\u7684\u94A5\u5319\u7ED9\u4E86\u6211\u3002"
    endsDialogue: 0
    choices: []
  - nodeId: teresa_05
    speakerName: "\u7279\u857E\u838E"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u90A3\u4E9B\u7BB1\u5B50\u91CC\u88C5\u7684\u6216\u8BB8\u662F\u6B66\u5668\uFF0C\u6211\u4E0D\u4F1A\u4F7F\u7528\u6B66\u5668\uFF0C\u5C31\u628A\u94A5\u5319\u4FDD\u7559\u81F3\u4ECA\uFF0C\u5E0C\u671B\u5BF9\u4F60\u6709\u6240\u5E2E\u52A9\u3002"
    endsDialogue: 0

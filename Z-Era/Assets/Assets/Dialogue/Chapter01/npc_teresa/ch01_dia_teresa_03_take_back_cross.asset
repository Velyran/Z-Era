    speakerName: "\u7279\u857E\u838E"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u662F\u7684\uFF0C\u8FD9\u4E2A\u5C31\u662F\u795E\u7236\u9057\u843D\u7684\u5341\u5B57\u67B6\u3002\u795E\u7236\u5148\u751F\uFF0C\u613F\u4F60\u5B89\u606F......"

  - nodeId: william_04
    speakerName: "\u5A01\u5EC9"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u4F60\u613F\u610F\u5E2E\u5FD9\u771F\u662F\u592A\u597D\u4E86\uFF01\u7070\u6E2F\u533B\u9662\u5206\u4E3A\u56DB\u90E8\u5206\uFF0C\u7D22\u83F2\u4E9A\u9700\u8981\u7684\u836F\u5728\u6025\u8BCA\u5927\u697C\u9876\u5C42\uFF0C\u4F46\u662F\u5177\u4F53\u5728\u54EA\u9700\u8981\u4F60\u627E\u4E00\u4E0B\uFF0C\u5F53\u65F6\u8DD1\u5F97\u5306\u5FD9\uFF0C\u5979\u5FD8\u8BB0\u4E86\u836F\u7684\u4F4D\u7F6E\u3002"

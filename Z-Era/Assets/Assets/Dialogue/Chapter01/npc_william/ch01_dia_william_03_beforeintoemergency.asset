    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u867D\u7136\u73B0\u5728\u524D\u5F80\u53E6\u4E00\u5934\u7684\u96A7\u9053\u4F1A\u5B58\u5728\u56F0\u96BE\uFF0C\u4F46\u6211\u4EEC\u53EF\u4EE5\u5E2E\u52A9\u4F60\uFF0C\u6211\u4EEC\u662F\u7070\u6E2F\u672C\u5730\u4EBA\uFF0C\u5BF9\u600E\u4E48\u53BB\u96A7\u9053\u8FD8\u662F\u6709\u529E\u6CD5\u7684\uFF0C\u53EA\u662F......"

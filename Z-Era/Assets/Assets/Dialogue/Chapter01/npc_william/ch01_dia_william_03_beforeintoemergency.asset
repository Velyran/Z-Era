    portrait: {fileID: 0}
    text: "\u6211\u8FD9\u91CC\u8FD8\u6709\u4E00\u4E9B\u624B\u67AA\u5F39\u836F\uFF0C\u867D\u7136\u6211\u4E0D\u4F1A\u7528\u67AA\uFF0C\u4F46\u8FD8\u662F\u5728\u707E\u96BE\u53D1\u751F\u540E\u5230\u5904\u641C\u96C6\u4E86\u4E00\u4E9B\u5F39\u836F\uFF0C\u73B0\u5728\u603B\u7B97\u662F\u6D3E\u4E0A\u7528\u573A\u4E86\u3002"

  - nodeId: william_02
    speakerName: "\u5A01\u5EC9"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u4E0D\u7792\u4F60\u8BF4\uFF0C\u6211\u4EEC\u6709\u4E2A\u8BF7\u6C42\uFF0C\u6211\u4EEC\u5E0C\u671B\u4F60\u80FD\u5E2E\u6211\u4EEC\u5230\u533B\u9662\u4E0A\u5C42\u53D6\u836F\u3002\u7D22\u83F2\u4E9A\u5E94\u8BE5\u8DDF\u4F60\u8BF4\u4E86\uFF0C\u5F53\u521D\u6025\u4E8E\u9003\u547D\uFF0C\u6765\u4E0D\u53CA\u628A\u5979\u6CBB\u7597\u6240\u9700\u8981\u7684\u836F\u5E26\u8D70\u3002"
    choices: []
  - nodeId: william_03
    speakerName: "\u5A01\u5EC9"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u8FD9\u59D1\u5A18\u7684\u75C5\u9700\u8981\u8FD9\u79CD\u836F\u6765\u7EF4\u6301\u6CBB\u7597\uFF0C\u5426\u5219\u5979\u4F1A\u8D8A\u6765\u8D8A\u865A\u5F31\uFF0C\u6700\u540E\u53EF\u80FD\u751A\u81F3\u633A\u4E0D\u8FC7\u53BB......\u6211\u77E5\u9053\u4F60\u9700\u8981\u8FFD\u4E0A\u5927\u90E8\u961F\uFF0C\u4F46\u6211\u4EEC\u8FD9\u91CC\u53EA\u6709\u4F60\u6709\u6B66\u5668\uFF0C\u5E76\u4E14\u4F1A\u4F7F\u7528\u6B66\u5668\uFF0C\u6240\u4EE5\u6211\u4EEC\u5E0C\u671B\u5F97\u5230\u4F60\u7684\u5E2E\u52A9\u3002"
    choices:
    - buttonText: "\u6211\u4F1A\u5E2E\u5FD9\uFF0C\u8FD9\u4E5F\u662F\u8054\u90A6\u58EB\u5175\u8D23\u4EFB\u7684\u4E00\u90E8\u5206\u3002"

  - nodeId: william_04
    speakerName: "\u5A01\u5EC9"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u5982\u679C\u9700\u8981\u98DF\u7269\u7B49\u8D44\u6E90\uFF0C\u53EF\u4EE5\u53BB\u533B\u9662\u5BF9\u9762\u7684\u8D85\u5E02\u770B\u770B\u3002\u707E\u96BE\u53D1\u751F\u65F6\u8D85\u5E02\u91CC\u7684\u8D27\u7269\u51E0\u4E4E\u88AB\u62A2\u7A7A\u4E86\uFF0C\u4F46\u5E94\u8BE5\u8FD8\u5269\u4E0B\u4E00\u4E9B\u96F6\u6563\u7684\u8D44\u6E90\u3002\u4F60\u53EF\u4EE5\u4E0D\u7528\u4ED8\u94B1\uFF0C\u6BD5\u7ADF\u4E5F\u6CA1\u6709\u6536\u94F6\u5458\u62DB\u5F85\u4F60\u4E86\u3002"

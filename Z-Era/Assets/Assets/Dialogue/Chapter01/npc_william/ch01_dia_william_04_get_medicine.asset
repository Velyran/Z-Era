  - nodeId: william_03
    speakerName: "\u5A01\u5EC9"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u76EE\u524D\u7684\u60C5\u51B5\u4E5F\u53EA\u80FD\u8FD9\u6837\u4E86\uFF0C\u6211\u4F1A\u518D\u4ED4\u7EC6\u67E5\u770B\u9644\u8FD1\u7684\u60C5\u51B5\u3002"

  - nodeId: william_02
    speakerName: "\u5A01\u5EC9"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u5728\u4F60\u53BB\u53D6\u836F\u7684\u65F6\u5019\uFF0C\u6211\u53BB\u9644\u8FD1\u67E5\u770B\u4E86\u4E00\u4E0B\u60C5\u51B5\uFF0C\u4ECE\u533B\u9662\u524D\u5F80\u96A7\u9053\u7684\u5404\u65B9\u5411\u7684\u9053\u8DEF\u90FD\u88AB\u66B4\u5F92\u7528\u6C7D\u8F66\u6216\u8DEF\u969C\u62E6\u4F4F\u4E86\uFF0C\u6CA1\u6CD5\u901A\u884C\u3002\u6216\u8BB8\u8FD8\u6709\u5176\u4ED6\u65B9\u6CD5\uFF0C\u4F46\u6211\u5F97\u82B1\u4E00\u4E9B\u65F6\u95F4\u3002"
    choices:
    - buttonText: "\u5728\u4F60\u627E\u5230\u4E4B\u524D\uFF0C\u6216\u8BB8\u6211\u53EF\u4EE5\u5728\u8FD9\u91CC\u6574\u987F\u4E00\u4E0B\u3002"

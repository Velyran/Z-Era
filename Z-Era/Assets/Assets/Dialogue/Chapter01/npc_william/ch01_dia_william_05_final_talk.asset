    text: "\u542C\u4ED6\u4EEC\u8BF4\u4F60\u53BB\u8054\u90A6\u519B\u961F\u4E34\u65F6\u8425\u5730\u4E86\uFF0C\u600E\u4E48\u6837\uFF0C\u6709\u6CA1\u6709\u4EC0\u4E48\u53D1\u73B0\uFF1F"
    endsDialogue: 0
    choices:
    - buttonText: "\uFF08\u5411\u5A01\u5EC9\u7B80\u8981\u8BB2\u8FF0\u4E86\u8425\u5730\u91CC\u7684\u4FE1\u606F\uFF09"

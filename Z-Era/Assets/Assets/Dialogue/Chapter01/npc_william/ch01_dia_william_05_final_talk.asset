        m_PersistentCalls:
          m_Calls: []
  - nodeId: intro4
    speakerName: "\u5A01\u5EC9"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u597D\u6D88\u606F\u5C31\u662F\u6211\u627E\u5230\u4E86\u7A7F\u8FC7\u8FD9\u7247\u5C01\u9501\u533A\u57DF\u7684\u65B9\u6CD5\uFF0C\u90A3\u5C31\u662F\u7A7F\u8FC7\u533B\u9662\u53F3\u4FA7\u7684\u4E00\u680B\u529E\u516C\u697C\u3002\u8FD9\u680B\u697C\u9760\u8FD1\u6211\u4EEC\u8FD9\u4FA7\u7684\u95E8\u5E76\u6CA1\u6709\u4E0A\u9501\uFF0C\u4F60\u53EF\u4EE5\u8FDB\u5165\u5E76\u4ECE\u529E\u516C\u697C\u5185\u90E8\u7A7F\u8FC7\u53BB\u3002"
    endsDialogue: 0
    choices: []
  - nodeId: intro5
    speakerName: "\u5A01\u5EC9"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u574F\u6D88\u606F\u662F\u53E6\u4E00\u8FB9\u95E8\u7684\u94A5\u5319\uFF0C\u6216\u8BB8\u6389\u5728\u4E86\u697C\u91CC\u7684\u67D0\u4E2A\u5730\u65B9\uFF0C\u6211\u539F\u672C\u60F3\u627E\uFF0C\u4F46\u662F\u91CC\u9762\u6709\u611F\u67D3\u8005\uFF0C\u5C31\u5148\u8FD4\u56DE\u628A\u60C5\u51B5\u544A\u8BC9\u4F60\u3002"
    endsDialogue: 0
    choices:
    - buttonText: "\u611F\u8C22\u4F60\u7684\u4FE1\u606F\uFF0C\u6211\u4F1A\u53BB\u627E\u5230\u94A5\u5319\u7684\u3002"
      requiredFlags: []
      forbiddenFlags: []
      nextNodeId: 

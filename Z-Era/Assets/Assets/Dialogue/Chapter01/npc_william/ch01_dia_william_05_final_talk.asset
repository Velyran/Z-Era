  - nodeId: intro2
    speakerName: "\u5A01\u5EC9"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u55EF......\u770B\u6765\u8DDF\u6211\u4EEC\u4E4B\u524D\u83B7\u5F97\u7684\u4FE1\u606F\u5DEE\u4E0D\u591A\uFF0C\u4ED6\u4EEC\u786E\u5B9E\u60F3\u627E\u5230\u5269\u4E0B\u5931\u8E2A\u7684\u58EB\u5175\u4EE5\u53CA\u5E2E\u52A9\u7070\u6E2F\u7684\u5E78\u5B58\u8005\uFF0C\u4F46\u662F\u4E0A\u5934\u8981\u6C42\u4ED6\u4EEC\u8D76\u5F80\u4E0B\u4E00\u4E2A\u4EFB\u52A1\u5730\u70B9\u3002\u597D\u4E00\u4E2A\u51B7\u9177\u65E0\u60C5\u7684\u8054\u90A6\u3002"
    endsDialogue: 0
    choices: []
  - nodeId: intro3
    speakerName: "\u5A01\u5EC9"
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    text: "\u540C\u65F6\u6211\u8FD9\u8FB9\u4E5F\u6709\u6240\u53D1\u73B0\uFF0C\u6709\u4E00\u4E2A\u597D\u6D88\u606F\u548C\u4E00\u4E2A\u574F\u6D88\u606F\uFF0C\u4F60\u60F3\u5148\u542C\u54EA\u4E00\u4E2A\uFF1F"
    endsDialogue: 0
    choices:
    - buttonText: "\u4E00\u8D77\u8BF4\u5427\uFF0C\u5BF9\u6211\u6765\u8BF4\u6CA1\u5DEE\u3002"
      requiredFlags: []
      forbiddenFlags: []
      nextNodeId: 
